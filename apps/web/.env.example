# Supabase
# URL + publishable key from Project Settings → API.
# The publishable key (sb_publishable_...) is the modern equivalent of the
# legacy `anon` key — RLS-gated and safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret. NEVER expose with NEXT_PUBLIC_*. Only set when a server
# action explicitly needs to bypass RLS (none today).
SUPABASE_SECRET_KEY=

# Database — Supavisor pooled URL (port 6543). Required only for the
# @memory-palace/db workspace; the web app starts without it today because
# the schema isn't built yet.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
