# ────── Supabase ──────
# Publishable key (sb_publishable_...) is the modern, RLS-gated, browser-safe
# key. The legacy `anon` JWT still works but is deprecated.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret key. Never expose to the browser. Only needed if a server
# action must bypass RLS (none today).
SUPABASE_SECRET_KEY=

# Pooled Supavisor — use everywhere in serverless. Port 6543.
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — only for long-lived migration tools (drizzle-kit).
DIRECT_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.com:5432/postgres"
