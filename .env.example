# ────── Supabase ──────
# Publishable key (sb_publishable_...) is the modern, RLS-gated, browser-safe
# key. The legacy `anon` JWT still works but is deprecated.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret key. Never expose to the browser. Only needed if a server
# action must bypass RLS (none today).
SUPABASE_SECRET_KEY=

# Pooled Supavisor — use everywhere in serverless. Port 6543.
# Transaction pool mode: prepare:false is set in the Drizzle client automatically.
DATABASE_URL="postgresql://postgres.nlaflvymxrjahyyyrzxf:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"

# Direct connection — only for long-lived migration tools (drizzle-kit). Port 5432.
DIRECT_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.nlaflvymxrjahyyyrzxf.supabase.com:5432/postgres"

# ────── Upstash Redis (rate limiting) ──────
# Required in production. When absent, rate limiting is a no-op (safe for local dev).
# Create a Redis database at https://console.upstash.com and copy the REST credentials.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ────── Site URL ──────
# Canonical public URL used in absolute redirects, sitemap, CORS, and OG tags.
# In Vercel deployments this is set automatically from the project domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ────── PostHog (analytics & observability) ──────
# When absent, PostHog is a no-op (safe for local dev without analytics).
# Get your key from https://us.posthog.com/settings/project-details
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
